    "Erstellt eine vollständige neue NUP einschließlich der Spieldaten. Übernehmen bearbeitet die Originaldatei direkt.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
