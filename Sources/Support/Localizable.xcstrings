    "Dateiänderungen werden vorgemerkt. Erst Übernehmen speichert sie gemeinsam mit den Metadaten; vorhandene Dateien werden nicht neu komprimiert.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen werden vorgemerkt. Erst Übernehmen speichert sie gemeinsam mit den Metadaten; vorhandene Dateien werden nicht neu komprimiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File changes are staged. Apply Changes saves them together with the metadata. Existing files are not recompressed."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificările fișierelor sunt pregătite pentru salvare. Aplică modificările le salvează împreună cu metadatele. Fișierele existente nu sunt recomprimate."
          }
        }
      }
    },
