      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut vollständig prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify All Files Again"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică din nou toate fișierele"
          }
        }
      }
    },
    "Erst Übernehmen entfernt vorhandene Dateien aus dem Paket. Vorgemerkte neue Dateien werden nur aus dem Entwurf genommen. Bisherige Datenblöcke können in der NUP verbleiben; die NUP wird nicht verkleinert.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erst Übernehmen entfernt vorhandene Dateien aus dem Paket. Vorgemerkte neue Dateien werden nur aus dem Entwurf genommen. Bisherige Datenblöcke können in der NUP verbleiben; die NUP wird nicht verkleinert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apply Changes removes existing files from the package. Staged new files are removed only from the draft. Old data blocks may remain in the NUP and the NUP will not shrink."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplică modificările elimină fișierele existente din pachet. Fișierele noi pregătite sunt eliminate doar din ciornă. Blocurile de date vechi pot rămâne în NUP, iar dimensiunea fișierului nu scade."
          }
        }
      }
    },
    "Erstellen": {
      "extractionState": "manual",
