    "Stufe 3 ist ein guter Ausgangspunkt. Dateien, die nicht kleiner werden, werden unkomprimiert gespeichert. Identische Inhalte teilen sich einen Datenbereich.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stufe 3 ist ein guter Ausgangspunkt. Dateien, die nicht kleiner werden, werden unkomprimiert gespeichert. Identische Inhalte teilen sich einen Datenbereich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Level 3 is a good starting point. Files that cannot be shrunk are stored uncompressed. Identical contents share a data region."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nivelul 3 este un punct de pornire bun. Fișierele care nu pot fi micșorate sunt stocate fără compresie. Conținuturile identice folosesc aceeași zonă de date."
          }
        }
      }
    },
